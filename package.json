{
  "name": "otitech",
  "version": "0.1.0",
  "private": true,
  "description": "OTI-TECH public-site development and browser smoke checks.",
  "scripts": {
    "preview": "http-server . -p 4173 -c-1",
    "test:smoke": "playwright test tests/phase1.smoke.spec.js --browser=chromium --workers=1",
    "test:lighthouse": "lhci autorun",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "backend:migrate": "cd backend && npm run migrate",
    "backend:seed": "cd backend && npm run seed",
    "backend:install": "cd backend && npm install",
    "install:all": "npm install && npm run backend:install",
    "generate:sitemap": "node scripts/generate-sitemap.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "http-server": "14.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "papaparse": "^5.7.0"
  }
}
