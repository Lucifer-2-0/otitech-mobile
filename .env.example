# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=otitech
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# First administrator (used by the seed command only)
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=OTI-TECH Administrator
ADMIN_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:4173

# Email (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=OTI-TECH <noreply@otitech.com>

# WhatsApp
WHATSAPP_BUSINESS_NUMBER=2349017017156

# File upload
UPLOAD_DIR=../uploads
MAX_FILE_SIZE=5242880

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Storage (S3/Cloudflare R2/Cloudinary)
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT= # For Cloudflare R2
AWS_S3_PUBLIC_URL= # Custom CDN domain
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Analytics (Plausible)
PLAUSIBLE_DOMAIN=otitech.com
PLAUSIBLE_API_HOST=https://plausible.io
