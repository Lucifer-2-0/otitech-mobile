FROM node:20-alpine AS site-metadata

WORKDIR /site
COPY scripts/generate-sitemap.js ./scripts/generate-sitemap.js
ARG SITE_URL=https://otitech.com
ENV SITE_URL=${SITE_URL}
RUN node scripts/generate-sitemap.js

FROM nginx:alpine AS runner

COPY index.html /usr/share/nginx/html/index.html
COPY css/ /usr/share/nginx/html/css/
COPY img/ /usr/share/nginx/html/img/
COPY js/ /usr/share/nginx/html/js/
COPY components/ /usr/share/nginx/html/components/
COPY pages/ /usr/share/nginx/html/pages/
COPY admin/ /usr/share/nginx/html/admin/
COPY --from=site-metadata /site/sitemap.xml /usr/share/nginx/html/sitemap.xml
COPY --from=site-metadata /site/robots.txt /usr/share/nginx/html/robots.txt
COPY nginx.conf /etc/nginx/templates/default.conf.template

ENV API_UPSTREAM=backend:3000

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
